<?xml version="1.0" encoding="utf-8"?>
<!--
  clawPDF — instalador MSI gerado via WiX Toolset v5 (Fases 4 e 5 do roteiro CI/CD).

  Decisões de arquitetura da Fase 4 (Handoff_SunTzu.md v1.5, 06_Fase4_Kickoff.md):
    1. .vdproj migrado para WiX Toolset (extensão VSIX no runner rejeitada
       por ser frágil em ambiente headless).
    3. Publicação do MSI como artifact do run (actions/upload-artifact) é
       o critério de sucesso da Fase 4.

  Decisões de arquitetura da Fase 5 (Handoff_SunTzu.md v1.7, 08_Fase5_Kickoff.md
  v1.1, 06/09/2026) — escopo fechado por completo:
    - MSI empacota Release|AnyCPU, sem símbolos de debug (.pdb excluídos)
    - Assinatura Authenticode self-signed aplicada no workflow (build.yml)
    - Version do pacote passada via $(var.ProductVersion), derivada da tag
      semver empurrada (ex: v1.2.3 -> 1.2.3.0); fallback 0.9.3.0 fora de tag
    - Custom actions de driver de impressora portadas do clawPDF_setup.vdproj
      original (SetupHelper.exe /Driver=Add|Remove) via <CustomAction> abaixo —
      ver Program.cs do SetupHelper: /Driver=Add chama Actions.InstallclawPDFPrinter()
      com retry via IsRepairRequired(); /Driver=Remove chama UninstallclawPDFPrinter()

  Limitação conhecida e deliberada (fora do escopo da Fase 5): as custom actions
  /ComInterface=Register|Unregister do instalador original (registro COM do
  clawPDF.exe via RegAsm, pra automação externa) NÃO foram portadas — a decisão
  do Sun Tzu falou especificamente em "driver de impressora", que é o que
  desbloqueia o endurecimento do smoke test. Registro COM é uma funcionalidade
  separada (automação de terceiros), não testada por nenhum smoke test existente.
  Fica como item de backlog se algum dia for necessário.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="clawPDF"
           Manufacturer="clawSoft"
           Version="$(var.ProductVersion)"
           UpgradeCode="2EB2882E-21C6-452A-A9FE-B7B08C925392"
           Language="1033"
           Codepage="1252">

    <SummaryInformation
      Description="clawPDF — instalador gerado via CI/CD, assinado com Authenticode self-signed (nao distribuido a terceiros, apenas para uso e aprendizado deste pipeline)." />

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do clawPDF (CI) já está instalada." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="clawPDF">
        <Component Id="ApplicationShortcutComponent" Guid="678ADCDD-6E77-4869-B785-19A417F239AB">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="clawPDF"
                    Directory="ProgramMenuFolder"
                    Target="[INSTALLFOLDER]clawPDF.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                          Key="Software\clawSoft\clawPDF_CI"
                          Name="installed"
                          Type="integer"
                          Value="1"
                          KeyPath="yes" />
        </Component>

        <!--
          SetupHelper.exe extraído do harvesting recursivo (Exclude abaixo) e
          declarado explicitamente aqui, com Id fixo ("SetupHelperExe"), porque
          as CustomAction abaixo precisam de um FileRef estável — o harvesting
          por wildcard gera Ids automáticos que não dá pra prever/referenciar.
        -->
        <Component Id="SetupHelperComponent" Guid="92D24513-C31B-4808-AA15-1887776CFC45">
          <File Id="SetupHelperExe" Source="$(var.BuildOutputDir)SetupHelper.exe" KeyPath="yes" />
          <File Id="SetupHelperExeConfig" Source="$(var.BuildOutputDir)SetupHelper.exe.config" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <!--
      Custom actions de instalação/remoção do driver de impressora, portadas do
      clawPDF_setup.vdproj original (que invocava o mesmo SetupHelper.exe com os
      mesmos argumentos como custom action tipo EXE). Execute="deferred" +
      Impersonate="no" porque instalar um driver de impressora exige privilégio
      de SYSTEM, não do usuário que disparou o msiexec (mesmo padrão do instalador
      original).

      AddDriver: Return="check" — se falhar, a instalação inteira falha. Faz
      sentido: um MSI que "instalou" sem o driver não cumpriu o que promete.
      RemoveDriver: Return="ignore" — remoção de driver é best-effort no
      uninstall, não deve travar o processo de desinstalação se falhar.
    -->
    <CustomAction Id="AddPrinterDriver"
                  FileRef="SetupHelperExe"
                  ExeCommand="/Driver=Add"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="RemovePrinterDriver"
                  FileRef="SetupHelperExe"
                  ExeCommand="/Driver=Remove"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="AddPrinterDriver" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RemovePrinterDriver" Before="RemoveFiles" Condition='Installed AND (REMOVE="ALL")' />
    </InstallExecuteSequence>

    <Feature Id="MainApplication" Title="clawPDF" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcutComponent" />
      <ComponentRef Id="SetupHelperComponent" />
    </Feature>

    <!--
      Harvesting recursivo (WiX v5 <Files Include>) em vez de listar cada
      arquivo/componente à mão — o build output tem ~60 arquivos na raiz
      mais subpastas (clawmon\Win32|x64|ARM64, docs\licenses, fonts,
      languages, tessdata). Preserva a estrutura de subpastas relativa a
      BuildOutputDir automaticamente.

      Exclude de *.pdb em qualquer profundidade — decisão Fase 5: MSI de release
      não carrega símbolos de debug. DebugType da config Release é "pdbonly" no
      .csproj, ou seja, os .pdb SÃO gerados ao lado dos binários; o exclude aqui
      é o que garante que não entrem no MSI final.

      Exclude de SetupHelper.exe/.config — declarados explicitamente acima
      (Component "SetupHelperComponent"), não pelo harvesting, pra ter um Id
      fixo referenciável pelas CustomAction.

      Bitness="always64" — achado do run real (06/09/2026, após adicionar
      Platform=x64 no .wixproj): sem isso, os <Directory> que o harvesting
      cria automaticamente pras subpastas (clawmon\Win32|x64|ARM64, languages,
      fonts, tessdata, docs\licenses) ficam marcados 32-bit por padrão, mesmo
      com os Components dentro deles marcados 64-bit (porque o pacote agora é
      x64) — gera erro de validação ICE80 ("64BitComponent uses 32BitDirectory").
    -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.BuildOutputDir)**" Bitness="always64">
        <Exclude Files="$(var.BuildOutputDir)**\*.pdb" />
        <Exclude Files="$(var.BuildOutputDir)SetupHelper.exe" />
        <Exclude Files="$(var.BuildOutputDir)SetupHelper.exe.config" />
      </Files>
    </ComponentGroup>

  </Package>
</Wix>
